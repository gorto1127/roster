<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Timetable with AG Grid</title>
    <!-- AG Grid CSS & JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community/styles/ag-grid.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/ag-grid-community/styles/ag-theme-alpine.css">
    <script src="https://cdn.jsdelivr.net/npm/ag-grid-community/dist/ag-grid-community.min.js"></script>
    <!-- PapaParse for CSV parsing -->
    <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>
    
    <style>
        body {
            margin: 20px;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }
        #header {
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        h1 {
            margin: 0;
            color: #333;
            font-size: 1.8em;
        }
        .refresh-btn {
            padding: 8px 16px;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.2s;
        }
        .refresh-btn:hover {
            background: #45a049;
        }
        .refresh-btn:active {
            transform: scale(0.98);
        }
        #status {
            color: #666;
            font-size: 0.9em;
        }
        #myGrid {
            width: 100%;
            height: calc(100vh - 120px);
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        /* Style for frozen cells to make them visually distinct */
        .ag-pinned-left-cols-container {
            border-right: 2px solid #007bff !important;
            background-color: #f8f9fa;
        }
        .ag-header-cell-pinned {
            background-color: #e9ecef !important;
        }
        .info-box {
            background: #e7f3ff;
            border-left: 4px solid #2196F3;
            padding: 10px 15px;
            margin-bottom: 15px;
            border-radius: 4px;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div id="header">
        <h1>📅 Interactive Timetable</h1>
        <button class="refresh-btn" onclick="refreshGrid()">
            🔄 Refresh Timetable Data
        </button>
        <div id="status">Last updated: <span id="lastUpdateTime">-</span></div>
    </div>
    
    <div class="info-box">
        ✅ <strong>Columns A & B and Rows 1 & 2 are frozen</strong> – they stay visible while scrolling.<br>
        Click the refresh button above to fetch the latest data from the spreadsheet.
    </div>
    
    <!-- AG Grid container -->
    <div id="myGrid" class="ag-theme-alpine"></div>

    <script>
        // 1. YOUR GOOGLE SHEET CSV URL
        const GOOGLE_SHEET_CSV_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTiZPBjakCcNDOtJVDhayA6pH4_AR1kJT_3dz5sR5veWcadc8-JGDEaujCeoKQ9ynX0cVLpfxjX5Gex/pub?gid=0&single=true&output=csv';
        
        // 2. Global reference to the grid
        let gridApi;
        
        // 3. Convert CSV to JSON format for AG Grid
        function processCSV(csvText) {
            const results = Papa.parse(csvText, {
                header: true, // First row becomes field names
                skipEmptyLines: true
            });
            
            if (results.errors.length > 0) {
                console.error('CSV parsing errors:', results.errors);
                return { columns: [], rows: [] };
            }
            
            const rows = results.data;
            const columns = results.meta.fields.map((fieldName, index) => {
                return {
                    headerName: fieldName,
                    field: fieldName,
                    sortable: true,
                    filter: true,
                    // Freeze first two columns (index 0 and 1)
                    pinned: index < 2 ? 'left' : null,
                    width: index < 2 ? 120 : 100,
                    cellStyle: index < 2 ? { backgroundColor: '#f8f9fa' } : {}
                };
            });
            
            return { columns, rows };
        }
        
        // 4. Fetch data from Google Sheet
        async function fetchTimetableData() {
            try {
                // Add cache busting to prevent browser caching
                const url = GOOGLE_SHEET_CSV_URL + '&cachebust=' + new Date().getTime();
                const response = await fetch(url);
                
                if (!response.ok) {
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                
                const csvText = await response.text();
                return processCSV(csvText);
                
            } catch (error) {
                console.error('Error fetching data:', error);
                alert('Failed to load timetable data. Please try again.');
                return { columns: [], rows: [] };
            }
        }
        
        // 5. Initialize and populate the grid
        async function initializeGrid() {
            const gridDiv = document.querySelector('#myGrid');
            
            // Grid configuration
            const gridOptions = {
                columnDefs: [], // Will be populated with data
                rowData: [],    // Will be populated with data
                defaultColDef: {
                    resizable: true,
                    filter: 'agTextColumnFilter',
                    floatingFilter: true,
                },
                // Enable freezing (pinning) of rows
                pinnedTopRowData: [],
                // Enable row selection
                rowSelection: 'multiple',
                suppressRowClickSelection: true,
                // Performance optimizations
                animateRows: true,
                // Ensure frozen columns are visually clear
                enableCellTextSelection: true,
                ensureDomOrder: true,
            };
            
            // Create the grid
            gridApi = agGrid.createGrid(gridDiv, gridOptions);
            
            // Load initial data
            await refreshGrid();
        }
        
        // 6. Refresh function (called by button)
        async function refreshGrid() {
            const statusEl = document.getElementById('lastUpdateTime');
            statusEl.textContent = 'Loading...';
            
            const { columns, rows } = await fetchTimetableData();
            
            if (gridApi) {
                // Update columns if structure changed
                gridApi.setGridOption('columnDefs', columns);
                
                // Update rows
                gridApi.setGridOption('rowData', rows);
                
                // Set first two rows as frozen (pinned)
                if (rows.length >= 2) {
                    gridApi.setGridOption('pinnedTopRowData', [rows[0], rows[1]]);
                } else if (rows.length === 1) {
                    gridApi.setGridOption('pinnedTopRowData', [rows[0]]);
                }
                
                // Auto-size columns to fit content
                gridApi.sizeColumnsToFit();
            }
            
            // Update timestamp
            const now = new Date();
            statusEl.textContent = now.toLocaleTimeString();
            console.log(`Timetable updated at ${now.toLocaleString()}`);
        }
        
        // 7. Initialize when page loads
        document.addEventListener('DOMContentLoaded', initializeGrid);
        
        // 8. Optional: Auto-refresh every 5 minutes (commented out)
        // setInterval(refreshGrid, 300000);
    </script>
</body>
</html>